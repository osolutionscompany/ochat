<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard form view -->
    <record id="view_ochat_create_ticket_wizard_form" model="ir.ui.view">
        <field name="name">ochat.create.ticket.wizard.form</field>
        <field name="model">ochat.create.ticket.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Ticket from O'Chat">
                <sheet>
                    <group>
                        <group>
                            <field name="channel_id" invisible="1"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="team_id" options="{'no_create': True}"/>
                            <field name="user_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="name" placeholder="e.g., Issue with product X"/>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe the issue in detail..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_ticket" string="Create Ticket" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_ochat_create_ticket_wizard" model="ir.actions.act_window">
        <field name="name">Create Ticket</field>
        <field name="res_model">ochat.create.ticket.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="mail.model_discuss_channel"/>
    </record>
</odoo>
