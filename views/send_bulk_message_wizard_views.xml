<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Send Bulk Message Wizard Form -->
    <record id="view_send_bulk_message_wizard_form" model="ir.ui.view">
        <field name="name">ochat.send.bulk.message.wizard.form</field>
        <field name="model">ochat.send.bulk.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Message to Multiple Connections">
                <sheet>
                    <group>
                        <field name="connection_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="message" widget="html" options="{'style-inline': true}"/>
                    </group>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_send_message" string="Send Message" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_send_bulk_message" model="ir.actions.act_window">
        <field name="name">Send Message</field>
        <field name="res_model">ochat.send.bulk.message.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_ochat_connection"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
