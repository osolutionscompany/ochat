<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Patch pour afficher l'icône de statut sur les messages O'Chat -->
    <t t-name="mail.Message" t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Message-textContent')]" position="inside">
            <!-- Afficher le statut si le message a un ochat_delivery_status -->
            <t t-if="message.ochat_delivery_status">
                <span class="ochat_status_indicator ms-2 d-inline-block">
                    <!-- Status: Pending -->
                    <t t-if="message.ochat_delivery_status === 'pending'">
                        <i class="fa fa-clock-o text-muted" title="En attente d'envoi"/>
                    </t>

                    <!-- Status: Delivered -->
                    <t t-elif="message.ochat_delivery_status === 'delivered'">
                        <i class="fa fa-check text-muted" title="Délivré"/>
                    </t>

                    <!-- Status: Failed -->
                    <t t-elif="message.ochat_delivery_status === 'failed'">
                        <i class="fa fa-times-circle text-danger"
                           t-attf-title="Échec après {{message.ochat_retry_count}} tentatives: {{message.ochat_failed_reason or 'Erreur inconnue'}}"/>
                    </t>
                </span>
            </t>
        </xpath>
    </t>

</templates>
