<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Template réutilisable pour l'icône de statut O'Chat -->
    <t t-name="ochat.StatusIndicator">
        <t t-if="props.message.ochat_fastapi_message_id and props.message.ochat_delivery_status">
            <span class="o-mail-OchatStatusContainer ms-1">
                <!-- Status: Pending -->
                <t t-if="props.message.ochat_delivery_status == 'pending'">
                    <i class="fa fa-clock-o text-muted" title="En attente d'envoi"/>
                </t>

                <!-- Status: Delivered -->
                <t t-elif="props.message.ochat_delivery_status == 'delivered'">
                    <i class="fa fa-check text-success" title="Délivré"/>
                </t>

                <!-- Status: Failed -->
                <t t-elif="props.message.ochat_delivery_status == 'failed'">
                    <i class="fa fa-times-circle text-danger"
                       t-attf-title="Échec après {{props.message.ochat_retry_count}} tentatives"/>
                </t>
            </span>
        </t>
    </t>

    <!-- Patch pour afficher l'icône de statut sur les messages O'Chat -->
    <t t-name="ochat.Message" t-inherit="mail.Message" t-inherit-mode="extension">
        <!-- Ajouter l'indicateur de statut après le MessageSeenIndicator dans le header -->
        <xpath expr="//div[hasclass('o-mail-Message-header')]//MessageSeenIndicator" position="after">
            <t t-call="ochat.StatusIndicator"/>
        </xpath>
    </t>

</templates>
