<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Patch to display status icon on O'Chat messages -->
    <t t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Message-textContent')]" position="inside">
            <!-- Display status only for outgoing O'Chat messages -->
            <div t-if="message.ochat_fastapi_message_id and message.ochat_delivery_status"
                 class="ochat-status-indicator d-flex align-items-center mt-1">
                <!-- Status: Pending -->
                <t t-if="message.ochat_delivery_status === 'pending'">
                    <i class="fa fa-clock-o text-muted" title="Pending"/>
                </t>

                <!-- Status: Delivered -->
                <t t-elif="message.ochat_delivery_status === 'delivered'">
                    <i class="fa fa-check text-muted" title="Delivered"/>
                </t>

                <!-- Status: Failed -->
                <t t-elif="message.ochat_delivery_status === 'failed'">
                    <i class="fa fa-times-circle text-danger" t-attf-title="Failed{{message.ochat_failed_reason ? ': ' + message.ochat_failed_reason : ''}}"/>
                </t>
            </div>
        </xpath>
    </t>

</templates>
