<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ochat.ThreadIcon" t-inherit="mail.ThreadIcon" t-inherit-mode="extension">
        <xpath expr="//div[@t-elif and contains(@class, 'oi-users')]" position="after">
            <div t-elif="props.thread.channel_type === 'ochat'" class="fa fa-fw fa-comments text-info" t-att-class="largeClass" title="O'Chat"/>
        </xpath>
    </t>
</templates>
