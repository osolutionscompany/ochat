<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job pour synchroniser les demandes de connexion -->
        <record id="cron_sync_connection_requests" model="ir.cron">
            <field name="name">O'Chat: Synchronize Connection Requests</field>
            <field name="model_id" ref="model_ochat_connection"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_connection_requests()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>
    </data>
</odoo>
